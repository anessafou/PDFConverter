{
  "name": "pdfconverter-space",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "quality-gate": "tsc --noEmit && npm run build",
    "postinstall": "node scripts/prepare-pdf-worker.mjs",
    "predev": "node scripts/prepare-pdf-worker.mjs",
    "prebuild": "node scripts/prepare-pdf-worker.mjs && node scripts/validate-pseo-publication.cjs",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "next": "^15.1.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "mammoth": "^1.11.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "tsx": "^4.20.0",
    "@playwright/test": "^1.56.0",
    "@electric-sql/pglite": "^0.3.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
