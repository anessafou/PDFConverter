# Domain
NEXT_PUBLIC_BASE_URL="https://www.pdfconverter.space"

# Secret Admin Portal Configuration (Use at least 32 random characters in production)
ADMIN_SECRET_KEY="your-secure-random-secret-key-min-32-chars"

# PostgreSQL Connection (e.g., Neon.tech pooled connection string)
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Optional Backend Worker URL
CONVERSION_WORKER_URL="http://localhost:8080"